<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="NotNull.MainWindow"
    Title="NotNull">

    <TabControl>
        <TabItem Header= "AreaControl">
                <Grid ColumnDefinitions="3*,*" RowDefinitions="Auto,*">

                <TextBlock Name="Moves"
                        Text="Blue to move"
                        Grid.Column="0"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Padding= "10"
                        HorizontalAlignment="Left"/>

            
                    <Grid Grid.Column="0"
                        Grid.Row="1"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="*,*,*">
                    
                      <Grid.Styles>

                          <Style Selector="Button">
                            
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>


                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                    </Border>
                                </ControlTemplate>
                            </Setter>


                          </Style>

                      </Grid.Styles>
                  
                      <Button Grid.Row="0" Grid.Column="0" Click="OnCellClick"/>
                      <Button Grid.Row="0" Grid.Column="1" Click="OnCellClick"/>
                      <Button Grid.Row="0" Grid.Column="2" Click="OnCellClick"/>
                  
                      <Button Grid.Row="1" Grid.Column="0" Click="OnCellClick"/>
                      <Button Grid.Row="1" Grid.Column="1" Click="OnCellClick"/>
                      <Button Grid.Row="1" Grid.Column="2" Click="OnCellClick"/>
                  
                      <Button Grid.Row="2" Grid.Column="0" Click="OnCellClick"/>
                      <Button Grid.Row="2" Grid.Column="1" Click="OnCellClick"/>
                      <Button Grid.Row="2" Grid.Column="2" Click="OnCellClick"/>
                  
                    </Grid>

            
                <StackPanel Grid.Column="1"
                            Grid.Row="1"
                            Spacing="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
            
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="FontSize" Value="30"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </StackPanel.Styles>

                    <Button Content="Play"/>
                    <Button Content="Save"/>
                    <Button Content="Load"/>
                    <Button Content="Grid"/>
                </StackPanel>
            
            </Grid>

        </TabItem>

    </TabControl>

</Window>